{
  "app-id": "org.bitcoinlifeboat.BitcoinLifeboat",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "bitcoin-lifeboat",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-documents"
  ],
  "modules": [
    {
      "name": "bitcoin-lifeboat",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bitcoin-lifeboat /app/bin/bitcoin-lifeboat",
        "install -Dm644 org.bitcoinlifeboat.BitcoinLifeboat.desktop /app/share/applications/org.bitcoinlifeboat.BitcoinLifeboat.desktop",
        "install -Dm644 org.bitcoinlifeboat.BitcoinLifeboat.metainfo.xml /app/share/metainfo/org.bitcoinlifeboat.BitcoinLifeboat.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/__GH_ORG__/bitcoin-lifeboat/releases/download/v0.2.0-alpha.1/bitcoin-lifeboat-v0.2.0-alpha.1-linux-x86_64-flatpak-source.tar.gz",
          "sha256": "__SHA256_FLATPAK_SOURCE__"
        }
      ]
    }
  ]
}
