{
  "name": "bitcoin-lifeboat-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bitcoin Lifeboat desktop frontend (Tauri 2 webview). UI shell with Tailwind, Zustand, i18n, and routing scaffolded in US-044; screens are filled in US-045+.",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:guardrails && tsc --noEmit && vite build",
    "e2e": "playwright test",
    "e2e:no-network": "node scripts/no-network-egress.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:guardrails && vitest run",
    "test:guardrails": "node scripts/verify-frontend-guardrails.test.mjs && node scripts/verify-i18n.test.mjs && node scripts/verify-heir-walkthrough-copy.mjs",
    "test:watch": "vitest",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "verify:guardrails": "node scripts/verify-frontend-guardrails.mjs && node scripts/verify-i18n.mjs && node scripts/verify-heir-walkthrough-copy.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:security": "npm run verify:capabilities && npm run verify:guardrails"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "i18next": "^26.3.0",
    "markdown-it": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.30.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
